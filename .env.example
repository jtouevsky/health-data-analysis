# HealthLab needs no secrets, API keys or accounts, and makes no network calls with your data.
# These optional environment variables are the only runtime switches. HealthLab itself does not read .env files;
# export them in your shell (or use a tool that loads .env) if you want them.

# Point every command and the app at the synthetic demo database instead of your real one (1/true/yes/on).
DEMO_MODE=0

# Use a config file other than config/healthlab.yaml.
# HEALTHLAB_CONFIG=/path/to/your/healthlab.yaml
